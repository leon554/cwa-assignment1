generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ActivityType {
  WORDLE
  WORD_SEARCH
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
}

model PhonemeWord {
  id               Int                  @id @default(autoincrement())
  englishWord      String
  phonemes         String[]
  wordLists        PhonemeWordList[]
  wordleActivities WordleActivity[]
  generationLogs   GenerationLog[]
}

model PhonemeWordList {
  id                   Int                  @id @default(autoincrement())
  name                 String
  words                PhonemeWord[]
  wordSearchActivities WordSearchActivity[]
  generationLogs       GenerationLog[]
}

model WordleActivity {
  id               Int         @id @default(autoincrement())
  name             String      @default("Untitled Wordle")
  word             PhonemeWord @relation(fields: [wordId], references: [id])
  wordId           Int
  maxGuesses       Int         @default(6)
  showEnglishWord  Boolean?
  createdAt        DateTime    @default(now())
}

model WordSearchActivity {
  id          Int             @id @default(autoincrement())
  name        String          @default("Untitled Word Search")
  wordList    PhonemeWordList @relation(fields: [wordListId], references: [id])
  wordListId  Int
  gridWidth   Int             @default(15)
  gridHeight  Int             @default(15)
  createdAt   DateTime        @default(now())
}

model GlobalSettings {
  id      Int    @id @default(1) 
  theme   String @default("dark")
  layout  String @default("comfortable")
}

model GenerationLog {
  id            Int              @id @default(autoincrement())
  activityType  ActivityType
  status        GenerationStatus
  errorMessage  String?
  durationMs    Int
  wordId        Int?
  word          PhonemeWord?     @relation(fields: [wordId], references: [id], onDelete: SetNull)
  wordListId    Int?
  wordList      PhonemeWordList? @relation(fields: [wordListId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  @@index([createdAt])
  @@index([activityType])
}

model PageView {
  id              Int      @id @default(autoincrement())
  route           String
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model ActivityEvent {
  id           Int          @id @default(autoincrement())
  activityType ActivityType
  action       ActivityAction
  createdAt    DateTime     @default(now())

  @@index([createdAt])
  @@index([activityType])
}